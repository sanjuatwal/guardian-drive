# Copy to .env and fill in your real values. .env is gitignored.

# Required for POST /api/v1/alerts/:id/police-pack to actually send email.
# Sign up free at https://resend.com, create an API key.
RESEND_API_KEY=

# Sender shown to the recipient. Must be a verified sender/domain in Resend,
# or use their onboarding address for testing: onboarding@resend.dev
RESEND_FROM_EMAIL="Guardian Drive <onboarding@resend.dev>"
